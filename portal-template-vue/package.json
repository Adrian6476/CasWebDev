{
  "name": "portal-template-vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-env.js",
    "dev": "vite",
    "prebuild": "node scripts/check-env.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .eslintignore",
    "format": "prettier --write",
    "format:all": "prettier --write src/",
    "prepare": "cd .. && husky install portal-template-vue/.husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@pinia/nuxt": "^0.9.0",
    "@vueuse/core": "^12.4.0",
    "axios": "^1.7.9",
    "chalk": "^4.1.2",
    "firebase": "^11.2.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "marked": "^15.0.6",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "sass": "^1.83.4",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.2",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@originjs/vite-plugin-federation": "^1.3.9",
    "@rushstack/eslint-patch": "^1.7.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "8.57.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-vitest-globals": "^1.5.0",
    "eslint-plugin-vue": "^9.21.0",
    "husky": "^8.0.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "rollup-plugin-visualizer": "^5.14.0",
    "vite": "^6.0.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^3.0.4"
  },
  "lint-staged": {
    "*.{vue,js,jsx,cjs,mjs}": [
      "npm run lint",
      "npm run format"
    ],
    "*.{scss,css,html,json,md}": [
      "npm run format"
    ]
  }
}
