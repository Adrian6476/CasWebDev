# Firebase配置
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# API配置
VITE_API_BASE_URL=https://api.production.com

# 生产环境配置
VITE_APP_TITLE=Portal Template Vue
VITE_OUTPUT_DIR=dist

# 构建优化配置
VITE_ENABLE_COMPRESS=true
VITE_COMPRESS_TYPE=gzip
VITE_DROP_CONSOLE=true
VITE_DROP_DEBUGGER=true
VITE_SOURCEMAP=false
VITE_ENABLE_ANALYZE=false

# 缓存配置
VITE_BUILD_CACHE=true
VITE_CACHE_DIR=node_modules/.vite

# 性能优化
VITE_IMAGE_INLINE_SIZE_LIMIT=4096
VITE_CHUNK_SIZE_WARNING_LIMIT=2000
VITE_LEGACY_BUILD=false

# 资源配置
VITE_ASSETS_DIR=assets
VITE_PUBLIC_DIR=public

# CDN配置（如果需要）
VITE_USE_CDN=false
VITE_CDN_URL=https://your-cdn-domain.com