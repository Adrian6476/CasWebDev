# 生产环境特有配置

# 构建优化配置
VITE_ENABLE_COMPRESS=true
VITE_COMPRESS_TYPE=gzip
VITE_DROP_CONSOLE=true
VITE_DROP_DEBUGGER=true
VITE_SOURCEMAP=false
VITE_ENABLE_ANALYZE=false

# 缓存配置
VITE_BUILD_CACHE=true
VITE_CACHE_DIR=node_modules/.vite

# 性能优化
VITE_IMAGE_INLINE_SIZE_LIMIT=4096
VITE_CHUNK_SIZE_WARNING_LIMIT=2000
VITE_LEGACY_BUILD=false

# 资源配置
VITE_ASSETS_DIR=assets
VITE_PUBLIC_DIR=public
VITE_OUTPUT_DIR=dist

# CDN配置
VITE_USE_CDN=false
VITE_CDN_URL=

# AI配置
VITE_AI_SYSTEM_PROMPT_ZH="你是一个专业的中文客服助手。你的职责是为用户提供优质的服务支持，解答问题，并确保用户获得最佳的服务体验。你必须始终使用中文回答。你应该：1.始终保持专业、友好和耐心；2.提供准确、简洁、易于理解的回答；3.在专业领域展现专业知识；4.在不确定的情况下，建议用户转接到人工客服；5.注意保护用户隐私，不询问或存储个人敏感信息。"

VITE_AI_SYSTEM_PROMPT_EN="You are a professional English-speaking customer service assistant. Your responsibility is to provide high-quality service support, answer questions, and ensure users receive the best service experience. You must always respond in English. You should: 1. Maintain professionalism, friendliness, and patience; 2. Provide accurate, concise, and easy-to-understand answers; 3. Demonstrate expertise in professional areas; 4. Suggest connecting with human customer service when uncertain; 5. Protect user privacy by not asking for or storing sensitive personal information."

# 注意：
# 1. Firebase等敏感配置保留在.env文件中
# 2. 生产环境的具体API地址等应在部署时通过环境变量注入
# 3. 这个文件只包含生产环境特有的构建和优化配置