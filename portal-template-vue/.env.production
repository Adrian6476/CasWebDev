# 生产环境特有配置

# 构建优化配置
VITE_ENABLE_COMPRESS=true
VITE_COMPRESS_TYPE=gzip
VITE_DROP_CONSOLE=true
VITE_DROP_DEBUGGER=true
VITE_SOURCEMAP=false
VITE_ENABLE_ANALYZE=false

# 缓存配置
VITE_BUILD_CACHE=true
VITE_CACHE_DIR=node_modules/.vite

# 性能优化
VITE_IMAGE_INLINE_SIZE_LIMIT=4096
VITE_CHUNK_SIZE_WARNING_LIMIT=2000
VITE_LEGACY_BUILD=false

# 资源配置
VITE_ASSETS_DIR=assets
VITE_PUBLIC_DIR=public
VITE_OUTPUT_DIR=dist

# CDN配置
VITE_USE_CDN=false
VITE_CDN_URL=

# 注意：
# 1. Firebase等敏感配置保留在.env文件中
# 2. 生产环境的具体API地址等应在部署时通过环境变量注入
# 3. 这个文件只包含生产环境特有的构建和优化配置