# 开发环境特有配置

# 开发服务器配置
VITE_DEV_SERVER_PORT=3001
VITE_DEV_SERVER_HOST=localhost

# 开发工具配置
VITE_ENABLE_MOCK=true
VITE_SOURCEMAP=true
VITE_ENABLE_ANALYZE=true

# 开发环境标题
VITE_APP_TITLE=Portal Template Vue (Dev)

# 开发时的API地址（会覆盖.env中的配置）
VITE_API_BASE_URL=https://jsonplaceholder.typicode.com

# 资源配置
VITE_ASSETS_DIR=assets
VITE_PUBLIC_DIR=public
VITE_OUTPUT_DIR=dist

# AI配置
VITE_AI_SYSTEM_PROMPT_ZH="你是一个专业的中文客服助手。你的工作是帮助用户解决问题，提供友好和专业的服务。每次回答要简洁明了，重点突出。遇到专业问题时要准确专业，遇到普通问题时要平易近人。如果遇到不确定的问题，要诚实地说明并建议用户联系人工客服。你只能使用中文回答。注意：这是开发环境，可以在回答末尾标注'[开发环境]'方便调试。"

VITE_AI_SYSTEM_PROMPT_EN="You are a professional English-speaking customer service assistant. Your job is to help users solve problems and provide friendly and professional service. Keep your answers concise and focused. Be accurate and professional when dealing with technical issues, and approachable for general questions. If you're unsure about something, be honest and suggest contacting human customer service. You must only respond in English. Note: This is a development environment, please add '[DEV]' at the end of each response for debugging purposes."

# 注意：Firebase等敏感配置应该保留在.env文件中
# 这个文件只包含开发环境特有的配置